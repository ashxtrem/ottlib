{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash|Edit|Write|NotebookEdit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/skills/plan-runner/scripts/guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/skills/plan-runner/scripts/guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/skills/plan-runner/scripts/guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/skills/plan-runner/scripts/guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\" hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
