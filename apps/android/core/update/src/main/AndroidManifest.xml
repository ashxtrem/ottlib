<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Installing a downloaded release APK; the user allows this once per app in system settings. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: once OttLib installed its own update, later updates can skip the confirmation prompt. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <receiver android:name="dev.ottlib.core.update.InstallResultReceiver" android:exported="false" />
    </application>
</manifest>
